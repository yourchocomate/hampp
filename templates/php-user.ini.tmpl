; Your PHP settings. hampp loads this file last, for php-fpm and the CLI,
; so anything here overrides hampp's and Termux's defaults.
; After editing run: hampp reload
;
; Examples:
;   memory_limit = 512M
;   upload_max_filesize = 128M
;   post_max_size = 128M
;   max_execution_time = 300
;   display_errors = On
;   opcache.enable = 0
