; Generated by hampp. Do not edit: it is rewritten on every start.
; Only hampp's own pool is loaded. The stock php-fpm.d/www.conf is not included
; because its `user` directive makes `php-fpm -t` fail on Android.

[global]
pid = {{.RunDir}}/php-fpm.pid
error_log = {{.LogDir}}/php-fpm.log
daemonize = yes

[hampp]
; No user/group: Termux is single-user and Android's seccomp blocks setuid.
listen = {{.PHPSock}}
listen.mode = 0600

; ondemand keeps idle workers at zero; Android kills apps that spawn too many
; child processes (phantom process limit: 32 across all apps).
pm = ondemand
pm.max_children = 3
pm.process_idle_timeout = 30s
pm.max_requests = 500

clear_env = no
catch_workers_output = yes
decorate_workers_output = no
php_admin_value[error_log] = {{.LogDir}}/php-error.log
php_admin_flag[log_errors] = on
