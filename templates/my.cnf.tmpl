# Generated by hampp. Do not edit: it is rewritten on every start.
# Uses the package datadir that the mariadb postinst initialised.
[mysqld]
datadir = {{.Prefix}}/var/lib/mysql
socket = {{.MySQLSock}}
port = {{.DBPort}}
# Never exposed to the LAN, even when `hampp share` is on.
bind-address = 127.0.0.1
pid-file = {{.RunDir}}/mariadb.pid
log-error = {{.LogDir}}/mariadb.log
tmpdir = {{.TmpDir}}
skip-name-resolve
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
# Phone-sized memory settings.
innodb_buffer_pool_size = 64M
performance_schema = OFF
max_connections = 50

[client]
socket = {{.MySQLSock}}
