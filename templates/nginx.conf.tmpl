# Generated by hampp. Do not edit: it is rewritten on every start.
worker_processes 1;
pid "{{.RunDir}}/nginx.pid";
error_log "{{.LogDir}}/nginx-error.log" warn;

events {
    worker_connections 256;
}

http {
    include "{{.Prefix}}/etc/nginx/mime.types";
    default_type application/octet-stream;
    sendfile on;
    keepalive_timeout 65;
    server_tokens off;
    # Termux's nginx defaults to 32-byte buckets, too small for names like
    # blog.192.168.1.5.nip.io ("could not build server_names_hash").
    server_names_hash_bucket_size 128;
    charset utf-8;
    client_max_body_size {{.PHP.UploadMax}};
    access_log "{{.LogDir}}/nginx-access.log";

    client_body_temp_path "{{.TmpDir}}/nginx-body";
    proxy_temp_path "{{.TmpDir}}/nginx-proxy";
    fastcgi_temp_path "{{.TmpDir}}/nginx-fastcgi";
    uwsgi_temp_path "{{.TmpDir}}/nginx-uwsgi";
    scgi_temp_path "{{.TmpDir}}/nginx-scgi";

    index index.php index.html index.htm;
{{- if .HTTPS}}
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:1m;
{{- end}}
{{range .Sites}}
    server {
        listen {{$.Listen}}:{{$.Port}}{{if .Default}} default_server{{end}};
{{- if $.HTTPS}}
        listen {{$.Listen}}:{{$.HTTPSPort}} ssl{{if .Default}} default_server{{end}};
        http2 on;
        ssl_certificate "{{.CertFile}}";
        ssl_certificate_key "{{.KeyFile}}";
{{- end}}
        server_name {{.Host}}{{range .Aliases}} {{.}}{{end}};
        root "{{.DocRoot}}";

        location / {
            try_files $uri $uri/ /index.php?$query_string;
        }

        location ~ \.php$ {
            try_files $uri =404;
            include "{{$.Prefix}}/etc/nginx/fastcgi_params";
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
            fastcgi_param HTTP_PROXY "";
            fastcgi_pass unix:{{$.PHPSock}};
        }

        # Hide dotfiles (.env, .git) but allow .well-known.
        location ~ /\.(?!well-known) {
            deny all;
        }
{{- if $.Adminer}}

        # Adminer is reachable from this phone only.
        location ^~ /adminer {
            allow 127.0.0.1;
            allow ::1;
            deny all;
            alias "{{$.AdminerDir}}";
            index index.php;
            location ~ \.php$ {
                include "{{$.Prefix}}/etc/nginx/fastcgi_params";
                fastcgi_param SCRIPT_FILENAME $request_filename;
                fastcgi_pass unix:{{$.PHPSock}};
            }
        }
{{- end}}
    }
{{end}}
}
