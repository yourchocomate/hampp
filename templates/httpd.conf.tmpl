# Generated by hampp. Do not edit: it is rewritten on every start.
# Change settings with `hampp config set` or ~/.config/hampp/config.toml.
ServerRoot "{{.Prefix}}"

{{range .Apache.Modules -}}
LoadModule {{.Name}} "{{.Path}}"
{{end}}
ServerName localhost
PidFile "{{.RunDir}}/httpd.pid"
DefaultRuntimeDir "{{.RunDir}}"
Mutex file:{{.RunDir}} default
ErrorLog "{{.LogDir}}/apache-error.log"
LogLevel warn
LogFormat "%h %t \"%r\" %>s %b \"%{Host}i\"" hampp
CustomLog "{{.LogDir}}/apache-access.log" hampp

# Android's phantom-process limit is 32 across all apps, so keep one child
# process and scale with threads instead.
<IfModule mpm_worker_module>
    StartServers            1
    ServerLimit             1
    ThreadLimit             25
    ThreadsPerChild         25
    MinSpareThreads         5
    MaxSpareThreads         25
    MaxRequestWorkers       25
    MaxConnectionsPerChild  0
</IfModule>

Listen {{.Listen}}:{{.Port}}
{{- if .HTTPS}}
Listen {{.Listen}}:{{.HTTPSPort}}
{{- end}}

{{if .Apache.MimeTypes}}TypesConfig "{{.Apache.MimeTypes}}"
{{end -}}
AddType application/javascript .mjs
AddType application/wasm .wasm
AddDefaultCharset UTF-8
DirectoryIndex index.php index.html index.htm
ServerTokens Prod
ServerSignature Off
TraceEnable Off
Timeout 120

<Directory />
    AllowOverride None
    Require all denied
</Directory>

# Hide dotfiles (.env, .git, .htaccess) everywhere.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
RedirectMatch 404 "/\.(git|svn|hg|env)(/|$)"

# PHP runs in php-fpm; only hand existing files to it.
<FilesMatch "\.php$">
    <If "-f %{REQUEST_FILENAME}">
        SetHandler "proxy:unix:{{.PHPSock}}|fcgi://localhost"
    </If>
</FilesMatch>
ProxyTimeout 300
{{range .Sites}}
<Directory "{{.DocRoot}}">
    Options FollowSymLinks
    AllowOverride All
    CGIPassAuth On
    Require all granted
</Directory>
{{- end}}
{{if .Adminer}}
# Adminer is reachable from this phone only, even when sharing on the LAN.
Alias /adminer "{{.AdminerDir}}"
<Directory "{{.AdminerDir}}">
    AllowOverride None
    DirectoryIndex index.php
    Require local
</Directory>
{{end}}
{{- if .HTTPS}}
SSLProtocol -all +TLSv1.2 +TLSv1.3
SSLSessionCache "shmcb:{{.RunDir}}/ssl_scache(512000)"
{{- end}}
{{range .Sites}}
<VirtualHost *:{{$.Port}}>
    ServerName {{.Host}}
{{- range .Aliases}}
    ServerAlias {{.}}
{{- end}}
    DocumentRoot "{{.DocRoot}}"
</VirtualHost>
{{- if $.HTTPS}}
<VirtualHost *:{{$.HTTPSPort}}>
    ServerName {{.Host}}
{{- range .Aliases}}
    ServerAlias {{.}}
{{- end}}
    DocumentRoot "{{.DocRoot}}"
    SSLEngine on
    SSLCertificateFile "{{.CertFile}}"
    SSLCertificateKeyFile "{{.KeyFile}}"
{{- if $.Apache.HTTP2}}
    Protocols h2 http/1.1
{{- end}}
</VirtualHost>
{{- end}}
{{end}}
