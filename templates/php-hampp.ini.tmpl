; Generated by hampp. Shared by php-fpm and the PHP CLI (composer, artisan)
; through PHP_INI_SCAN_DIR, after Termux's own conf.d, which hampp never edits.

; Termux builds PHP with the MySQL socket in $PREFIX/tmp, but MariaDB listens
; in $PREFIX/var/run.
mysqli.default_socket = "{{.MySQLSock}}"
pdo_mysql.default_socket = "{{.MySQLSock}}"
{{if .CABundle}}
; Trust hampp's local CA (plus the usual public roots) for HTTPS calls.
openssl.cafile = "{{.CABundle}}"
curl.cainfo = "{{.CABundle}}"
{{end}}