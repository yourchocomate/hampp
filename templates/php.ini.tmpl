; Generated by hampp: base settings for php-fpm (loaded with -c).
; Change values with `hampp php set <key> <value>` or `hampp php edit`.
memory_limit = {{.PHP.MemoryLimit}}
upload_max_filesize = {{.PHP.UploadMax}}
post_max_size = {{.PHP.UploadMax}}
max_execution_time = 120
max_input_vars = 5000

error_reporting = E_ALL
display_errors = {{if .PHP.DisplayError}}On{{else}}Off{{end}}
display_startup_errors = {{if .PHP.DisplayError}}On{{else}}Off{{end}}
log_errors = On
error_log = "{{.LogDir}}/php-error.log"
expose_php = Off
{{if .TimeZone}}date.timezone = "{{.TimeZone}}"
{{end}}
mysqli.default_port = {{.DBPort}}

session.save_path = "{{.TmpDir}}/php-sessions"
upload_tmp_dir = "{{.TmpDir}}"
sys_temp_dir = "{{.TmpDir}}"

opcache.enable = 1
opcache.validate_timestamps = 1
opcache.revalidate_freq = 0
; Sockets, CA trust, extensions and your overrides come from the scan dirs
; (PHP_INI_SCAN_DIR), which are loaded after this file.
