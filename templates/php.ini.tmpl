; Generated by hampp: base settings for php-fpm (loaded with -c).
; Change values with `hampp php set <key> <value>` or `hampp php edit`.
memory_limit = {{.PHP.MemoryLimit}}
upload_max_filesize = {{.PHP.UploadMax}}
post_max_size = {{.PHP.UploadMax}}
max_execution_time = 120
max_input_vars = 5000

error_reporting = E_ALL
display_errors = {{if .PHP.DisplayError}}On{{else}}Off{{end}}
display_startup_errors = {{if .PHP.DisplayError}}On{{else}}Off{{end}}
log_errors = On
error_log = "{{.LogDir}}/php-error.log"
expose_php = Off
{{if .TimeZone}}date.timezone = "{{.TimeZone}}"
{{end}}
mysqli.default_port = {{.DBPort}}

opcache.enable = 1
opcache.validate_timestamps = 1
opcache.revalidate_freq = 0
; Repeated from the shared scan dir on purpose: php-fpm always reads this file
; (it is passed with -c), while PHP_INI_SCAN_DIR support varies between builds.
; Everything temporary must live in a directory hampp creates and owns, or
; OPcache aborts with "Cannot create lock" and php-fpm never starts.
sys_temp_dir = "{{.TmpDir}}"
upload_tmp_dir = "{{.TmpDir}}"
session.save_path = "{{.TmpDir}}/php-sessions"
soap.wsdl_cache_dir = "{{.TmpDir}}"
opcache.lockfile_path = "{{.TmpDir}}"
opcache.file_cache = "{{.TmpDir}}/opcache"
mysqli.default_socket = "{{.MySQLSock}}"
pdo_mysql.default_socket = "{{.MySQLSock}}"
{{if .CABundle}}openssl.cafile = "{{.CABundle}}"
curl.cainfo = "{{.CABundle}}"
{{end}}
; Extensions and your own overrides come from the scan dirs, loaded after this.
